SPRING_APPLICATION_NAME=healthapp

POSTGRES_DB_URL=jdbc:postgresql://localhost:5433/healthapp
POSTGRES_DB_USERNAME=healthapp
POSTGRES_DB_PASSWORD=healthapp_dev

SPRING_JPA_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_FORMAT_SQL=true
SPRING_JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect

FLYWAY_ENABLED=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

JWT_SECRET=your-super-secret-key-that-is-at-least-32-characters-long
JWT_EXPIRATION_MS=86400000

SPRING_SECURITY_LOG_LEVEL=DEBUG

CLICKHOUSE_JDBC_URL=jdbc:clickhouse:http://localhost:8123/healthcare_queue
CLICKHOUSE_USERNAME=admin
CLICKHOUSE_PASSWORD=admin123

